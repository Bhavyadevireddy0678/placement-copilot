GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
API_KEY=replace-with-a-long-random-secret
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
SQL_ALLOW_PII_COLUMNS=false
POSTGRES_PASSWORD=replace-with-a-different-long-random-secret
DB_NAME=placement_rag
DB_USER=raguser
DB_PASSWORD=replace-with-a-long-random-secret
DB_HOST=localhost
DB_PORT=5432
API_PORT=8000
DATABASE_URL=
SQL_READONLY_PASSWORD=replace-with-a-different-long-random-secret
SQL_READONLY_DB_URL=postgresql://rag_readonly:URL_ENCODED_PASSWORD@localhost:5432/placement_rag
RAG_READONLY_DB_URL=postgresql://rag_readonly:URL_ENCODED_PASSWORD@localhost:5432/placement_rag
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
SQL_STATEMENT_TIMEOUT_MS=5000
GROQ_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=all-MiniLM-L6-v2
INGEST_BATCH_SIZE=64
RAG_TOP_K=3
RAG_DISTANCE_THRESHOLD=0.7
HYBRID_RETRIEVAL_ENABLED=false
EMBEDDING_CACHE_SIZE=512
SQL_RESULT_CACHE_SIZE=128
SQL_RESULT_CACHE_TTL_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=0.2
LLM_RETRY_MAX_SECONDS=2
LLM_RETRY_JITTER_SECONDS=0.1
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RESET_SECONDS=30
